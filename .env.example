# Copy to .env and fill in. See "Connecting Discord" in the README.
#
# The app boots without any of these — you just can't sign in with Discord or
# move anyone between voice channels until they're set.

# --- OAuth (sign in with Discord) -------------------------------------------
# Discord Developer Portal -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match a redirect URI registered on the app, exactly.
DISCORD_REDIRECT_URI=http://localhost:4000/auth/user/discord/callback

# --- Bot (moving people between voice channels) -----------------------------
# Discord Developer Portal -> your app -> Bot -> Reset Token.
# The bot must be in your server with the "Move Members" permission.
DISCORD_BOT_TOKEN=

# Optional: pre-select this server on the Discord settings screen.
DISCORD_GUILD_ID=

# Optional: the voice channel people are returned to when they leave a meeting
# room. Without it, walking out of a room leaves the call untouched.
# `mix breakaway.discord.setup` makes this channel and prints the line to paste.
DISCORD_LOBBY_CHANNEL_ID=
