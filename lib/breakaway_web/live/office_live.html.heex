<div class="flex h-screen w-screen overflow-hidden bg-[#14161c] text-zinc-100">
  <div class="relative flex-1">
    <%= if @space do %>
      <div
        id="stage"
        phx-hook="Office"
        phx-update="ignore"
        data-user-id={@current_user.id}
        class="absolute inset-0"
      >
        <canvas class="block h-full w-full"></canvas>
      </div>
    <% else %>
      <div class="absolute inset-0 grid place-items-center">
        <div class="max-w-md text-center">
          <p class="text-lg font-semibold">No office yet</p>
          <p class="mt-2 text-sm text-zinc-400">
            Run <code class="rounded bg-zinc-800 px-1.5 py-0.5">mix breakaway.seed</code>
            to create the default floor plan, then refresh.
          </p>
        </div>
      </div>
    <% end %>

    <div class="pointer-events-none absolute inset-0 flex flex-col justify-between p-4">
      <div class="flex items-start justify-between gap-3">
        <div class="pointer-events-auto rounded-xl bg-black/45 px-3 py-2 backdrop-blur">
          <p class="text-xs uppercase tracking-wider text-zinc-400">
            {(@space && @space.name) || "Breakaway"}
          </p>
          <p class="text-sm font-semibold">
            <%= if zone = @my_zone && @zone_index[@my_zone] do %>
              {zone.name}
              <span class="ml-1 text-xs font-normal text-zinc-400">
                {kind_label(zone.kind)}
              </span>
            <% else %>
              Walking the floor
            <% end %>
          </p>
        </div>

        <.voice_banner voice={@voice} />
      </div>

      <div class="flex items-end justify-between gap-4">
        <div class="pointer-events-auto w-full max-w-md">
          <div
            id="chat-log"
            class="mb-2 flex max-h-52 flex-col-reverse gap-1 overflow-y-auto pr-1 text-sm"
          >
            <div
              :for={message <- @messages}
              class="w-fit rounded-lg bg-black/50 px-2.5 py-1 backdrop-blur"
            >
              <span class="font-semibold text-amber-300">{message.name}</span>
              <span class="ml-1 text-zinc-100">{message.text}</span>
            </div>
          </div>

          <form
            id="chat-form"
            phx-hook="ChatInput"
            phx-submit="say"
            class="flex items-center gap-2 rounded-xl bg-black/50 px-3 py-2 backdrop-blur"
          >
            <input
              type="text"
              name="text"
              autocomplete="off"
              maxlength="240"
              placeholder="Say something to the room…"
              class="w-full bg-transparent text-sm outline-none placeholder:text-zinc-500"
            />
            <button
              type="submit"
              class="text-xs font-semibold text-amber-300 hover:text-amber-200"
            >
              Send
            </button>
          </form>
        </div>

        <.controls_overlay />
      </div>
    </div>
  </div>

  <aside class="flex w-80 shrink-0 flex-col border-l border-white/5 bg-[#1a1d24]">
    <header class="flex items-center justify-between border-b border-white/5 px-4 py-3">
      <div>
        <p class="text-sm font-semibold">In the office</p>
        <p class="text-xs text-zinc-500">{length(@roster)} here now</p>
      </div>
      <.link
        navigate={~p"/settings/discord"}
        class="rounded-lg bg-white/5 px-2.5 py-1.5 text-xs font-medium hover:bg-white/10"
      >
        Discord
      </.link>
    </header>

    <div class="flex-1 overflow-y-auto px-2 py-3">
      <div :for={{slug, name, people} <- grouped_roster(@roster, @zones)} class="mb-4">
        <div class="mb-1.5 flex items-center gap-2 px-2">
          <p class="text-xs font-semibold uppercase tracking-wider text-zinc-400">{name}</p>
          <span class="text-[11px] text-zinc-600">{length(people)}</span>
          <span
            :if={linked_zone?(@zone_index, slug)}
            title="Bound to a Discord voice channel"
            class="ml-auto rounded bg-indigo-500/15 px-1.5 py-0.5 text-[10px] font-medium text-indigo-300"
          >
            voice
          </span>
        </div>

        <div
          :for={person <- people}
          class={[
            "flex items-center gap-2.5 rounded-lg px-2 py-1.5",
            person.id == @current_user.id && "bg-white/5"
          ]}
        >
          <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-400"></span>
          <div class="min-w-0">
            <p class="truncate text-sm">{person.name}</p>
            <p :if={person.status} class="truncate text-xs text-zinc-500">{person.status}</p>
          </div>
        </div>
      </div>

      <p :if={@roster == []} class="px-3 py-6 text-center text-sm text-zinc-500">
        Nobody here yet.
      </p>
    </div>

    <footer class="border-t border-white/5 px-4 py-3">
      <div class="flex items-center justify-between gap-2">
        <button
          phx-click="edit_profile"
          class="-mx-2 min-w-0 flex-1 rounded-lg px-2 py-1 text-left hover:bg-white/5"
          title="Edit how you look"
        >
          <p class="truncate text-sm font-medium">{@current_user.display_name}</p>
          <p class="truncate text-xs text-zinc-500">
            {@current_user.status_message || "@" <> @current_user.discord_username}
          </p>
        </button>
        <.link
          href={~p"/sign-out"}
          method="get"
          class="shrink-0 text-xs text-zinc-500 hover:text-zinc-300"
        >
          Sign out
        </.link>
      </div>
    </footer>
  </aside>
</div>

<div
  :if={@editing_profile?}
  class="fixed inset-0 z-50 grid place-items-center bg-black/60 p-4 backdrop-blur-sm"
  phx-window-keydown="cancel_profile"
  phx-key="Escape"
>
  <div class="w-full max-w-md rounded-2xl border border-white/10 bg-[#1a1d24] p-6 shadow-2xl">
    <h2 class="text-lg font-semibold text-zinc-100">How you look</h2>
    <p class="mt-1 text-sm text-zinc-500">Everyone on the floor sees this.</p>

    <form phx-submit="save_profile" class="mt-5 space-y-5">
      <div>
        <label
          for="display_name"
          class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-zinc-400"
        >
          Name
        </label>
        <input
          id="display_name"
          type="text"
          name="display_name"
          value={@current_user.display_name}
          maxlength="40"
          required
          class="w-full rounded-lg border border-white/10 bg-[#14161c] px-3 py-2 text-sm text-zinc-100 outline-none focus:border-indigo-400"
        />
      </div>

      <div>
        <label
          for="status_message"
          class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-zinc-400"
        >
          Status
        </label>
        <input
          id="status_message"
          type="text"
          name="status_message"
          value={@current_user.status_message}
          maxlength="60"
          placeholder="Heads down until 3"
          class="w-full rounded-lg border border-white/10 bg-[#14161c] px-3 py-2 text-sm text-zinc-100 outline-none placeholder:text-zinc-600 focus:border-indigo-400"
        />
      </div>

      <fieldset>
        <legend class="mb-2 text-xs font-semibold uppercase tracking-wider text-zinc-400">
          Character
        </legend>
        <div class="flex flex-wrap gap-2">
          <label
            :for={palette <- palettes()}
            class="cursor-pointer rounded-xl border-2 border-transparent bg-[#14161c] p-1 hover:border-white/20 has-[:checked]:border-amber-300"
          >
            <input
              type="radio"
              name="avatar_palette"
              value={palette}
              checked={palette == @current_user.avatar_palette}
              class="sr-only"
            />
            <span
              class="block [image-rendering:pixelated]"
              style={"width:64px;height:80px;background-image:url('/images/avatars.png');background-size:320px 1920px;background-position:0 -#{palette_preview_offset(palette)}px"}
              role="img"
              aria-label={"Character #{palette + 1}"}
            ></span>
          </label>
        </div>
      </fieldset>

      <div class="flex justify-end gap-2 pt-1">
        <button
          type="button"
          phx-click="cancel_profile"
          class="rounded-lg px-3 py-2 text-sm text-zinc-400 hover:bg-white/5 hover:text-zinc-200"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="rounded-lg bg-indigo-500 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-400"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>
