# Loaded by direnv (https://direnv.net), so the credentials in .env are in the
# shell for `mix breakaway.discord.setup`, `psql` and anything else — not just
# `mix phx.server`, which reads .env itself in config/dev.exs.
#
# direnv blocks this file until you run `direnv allow`, and blocks it again
# after every edit to *this* file. Editing .env needs no re-allow: it is on
# direnv's watch list, so changes there reload on their own.
dotenv_if_exists .env
